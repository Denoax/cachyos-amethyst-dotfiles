#!/usr/bin/env python3
"""Copy the shipped CP workspace to a new writable folder; never replace a project."""
from pathlib import Path
import shutil
import sys

if len(sys.argv)!=2:raise SystemExit('Usage: amethyst-cp-init NEW_FOLDER')
destination=Path(sys.argv[1]).expanduser()
if destination.exists():raise SystemExit('Destination already exists; nothing overwritten')
source=Path.home()/'.local/share/cachyos-amethyst/vscode/workspace'
if not source.is_dir():raise SystemExit('Select --with dev-cp when installing')
shutil.copytree(source,destination)
print('Created',destination)
print('Open Amethyst-CP.code-workspace in official Microsoft VS Code and import Amethyst.code-profile once.')
