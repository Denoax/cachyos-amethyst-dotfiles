#!/usr/bin/env python3
"""Own only the three Arch terminals and a reversible gather of visible windows from every output."""
import fcntl,json,os,shutil,subprocess,sys,time,secrets
from pathlib import Path
RUN=Path(os.environ['XDG_RUNTIME_DIR'])/'caelestia-workspace';RUN.mkdir(mode=0o700,exist_ok=True)
CFG=Path.home()/'.config/cachyos-amethyst/machine.json'
settings=json.loads(CFG.read_text()) if CFG.is_file() else {}
MAIN=settings.get('preferred_output') or next((m['name'] for m in json.loads(subprocess.check_output(['hyprctl','-j','monitors'])) if m['focused']), '')
CLASSES=('MonoArchBtop','MonoArchInfo','MonoArchCava')
def get(name):return json.loads(subprocess.check_output(['hyprctl','-j',name],text=True,timeout=4))
def quote(v):return json.dumps(v,ensure_ascii=False)
def dispatch(code):subprocess.run(['hyprctl','dispatch',code],check=True,stdout=subprocess.DEVNULL,timeout=4)
def batch(codes):subprocess.run(['hyprctl','eval',';'.join('hl.dispatch('+c+')' for c in codes)],check=True,stdout=subprocess.DEVNULL,timeout=5)
def mon(name=MAIN):return next((m for m in get('monitors') if m['name']==name and not m['disabled']),None)
def owned():return [w for w in get('clients') if w['class'] in CLASSES]
def note(message):subprocess.run(['notify-send','-a','Caelestia','Workspace controls',message],check=False)
def atomic(p,value):
 t=p.with_suffix('.tmp');t.write_text(json.dumps(value,indent=2));t.replace(p)
def close_arch():
 for m in get('monitors'):
  if m['specialWorkspace'].get('name')=='special:arch':batch([f'hl.dsp.focus({{monitor={quote(m["name"])}}})','hl.dsp.workspace.toggle_special("arch")'])
 ws=owned()
 if ws:batch([f'hl.dsp.window.close({{window="address:{w["address"]}"}})' for w in ws])
 until=time.monotonic()+3
 while owned() and time.monotonic()<until:time.sleep(.04)
 if owned():note('An owned terminal did not close. The remaining group can be shown again; unrelated apps were not touched.')
def layout(m,windows,generation):
 # Use the Pixio's actual reserved area; do not depend on numeric monitor IDs.
 l,t,r,b=m['reserved'];gap=8;x=m['x']+l+16;y=m['y']+t+16;width=round(m['width']/m.get('scale',1))-l-r-32;height=round(m['height']/m.get('scale',1))-t-b-32
 left=round((width-gap)*.51);right=width-gap-left;top=round((height-gap)*.56)
 boxes=((x,y,left,height),(x+left+gap,y,right,top),(x+left+gap,y+top+gap,right,height-top-gap));codes=[]
 for cls,(xx,yy,ww,hh) in zip(CLASSES,boxes):
  w=next(w for w in windows if w['class']==cls);a=w['address']
  codes.extend([f'hl.dsp.window.resize({{window="address:{a}",x={ww},y={hh},relative=false}})',f'hl.dsp.window.move({{window="address:{a}",x={xx},y={yy},relative=false}})'])
 batch(codes)
 atomic(RUN/'arch-layout.json',{'monitor':MAIN,'generation':generation,'boxes':boxes,'windows':[{'class':w['class'],'address':w['address'],'pid':w['pid']} for w in windows]})
def arch():
 m=mon()
 if not m:note('Preferred output is unavailable; the terminal group was not opened elsewhere.');return
 if any(a['specialWorkspace'].get('name')=='special:arch' for a in get('monitors')):close_arch();return
 specs=((CLASSES[0],['btop']),(CLASSES[1],[str(Path.home()/'.local/bin/caelestia-arch-info')]),(CLASSES[2],['cava']))
 if not all(shutil.which(a[0]) for _,a in specs) or not shutil.which('kitty'):note('A required Kitty/btop/system-info/cava executable is missing. Nothing was opened.');return
 existing=owned()
 previous=json.loads((RUN/'arch-layout.json').read_text()) if (RUN/'arch-layout.json').exists() else {}
 generation=previous.get('generation') if any(w['class']=='MonoArchInfo' for w in existing) else None
 generation=generation or secrets.token_hex(8)
 if len({w['class'] for w in existing})!=len(existing):note('Duplicate owned terminal IDs found; close the group before retrying.');return
 try:
  for cls,args in specs:
   if any(w['class']==cls for w in existing):continue
   subprocess.Popen(['kitty','--override','confirm_os_window_close=0','--class',cls,'--title',cls,*args],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True,env={**os.environ,'MONO_ARCH_GENERATION':generation})
  deadline=time.monotonic()+6
  while True:
   windows=owned()
   if len(windows)==3 and all(w['mapped'] and w['size'][0]>10 and w['size'][1]>10 and w['workspace'].get('name')=='special:arch' for w in windows):break
   if time.monotonic()>deadline:raise RuntimeError('The three terminals did not all map in special:arch within six seconds.')
   time.sleep(.025)
  layout(m,windows,generation)
  # The info pane acknowledges its bounded, cleared render at the final size.
  deadline=time.monotonic()+3
  while True:
   try:
    if json.loads((RUN/'arch-info-ready.json').read_text()).get('generation')==generation:break
   except (OSError,ValueError):pass
   if time.monotonic()>deadline:raise RuntimeError('System-info pane did not become ready after layout.')
   time.sleep(.02)
  # One refresh/round trip confirms final hidden geometry before one reveal.
  windows=owned();expected=json.loads((RUN/'arch-layout.json').read_text())['boxes']
  if not all(w['floating'] for w in windows):raise RuntimeError('The scoped floating-placement rule is not loaded.')
  batch([f'hl.dsp.focus({{monitor={quote(MAIN)}}})','hl.dsp.workspace.toggle_special("arch")',f'hl.dsp.focus({{window="address:{next(w for w in windows if w["class"]==CLASSES[0])["address"]}"}})'])
 except Exception as exc:
  close_arch();note(str(exc)+' Owned terminals were cleaned up.');raise

def same_window(row,live):
 return live and live['pid']==row['pid'] and live['class']==row['class']
def representatives(rows):
 seen=set()
 # Move native groups as units, including the group's hidden tabs.
 for row in sorted(rows,key=lambda r:bool(r.get('hidden'))):
  members=set(row.get('grouped') or [])|{row['address']}
  if members & seen:continue
  seen.update(members);yield row
def unfullscreen(rows,live):
 codes=[]
 for row in rows:
  w=live.get(row['address'])
  if same_window(row,w) and w.get('fullscreen',0):codes.append(f'hl.dsp.window.fullscreen({{window="address:{w["address"]}",action="unset"}})')
 if codes:batch(codes)
def restore_collection(state,p):
 monitors=get('monitors');names={m['name'] for m in monitors}
 if any(r['output'] not in names for r in state['windows']):note('An original monitor is unavailable. Gather recovery is retained; reconnect it and press Super+D to restore.');return
 live={w['address']:w for w in get('clients')};rows=[r for r in state['windows'] if same_window(r,live.get(r['address']))]
 unfullscreen(rows,live)
 workspaces={w['id']:w for w in get('workspaces') if 'id' in w}
 codes=[]
 for m in state['monitors']:
  wid=m['workspace']
  if m['name'] in names and wid not in workspaces:
   codes.extend([f'hl.dsp.focus({{monitor={quote(m["name"])}}})',f'hl.dsp.focus({{workspace={wid}}})'])
 for row in representatives(rows):
  w=live[row['address']]
  if w['workspace'].get('id')!=row['workspace']:
   codes.append(f'hl.dsp.window.move({{window="address:{row["address"]}",workspace={row["workspace"]},follow=false}})')
 if codes:batch(codes)
 codes=[]
 for row in rows:
  if row['floating']:
   codes.extend([f'hl.dsp.window.resize({{window="address:{row["address"]}",x={row["size"][0]},y={row["size"][1]},relative=false}})',f'hl.dsp.window.move({{window="address:{row["address"]}",x={row["at"][0]},y={row["at"][1]},relative=false}})'])
  if row['fullscreen']:
   mode='fullscreen' if row['fullscreen']==2 else 'maximized';codes.append(f'hl.dsp.window.fullscreen({{window="address:{row["address"]}",mode="{mode}",action="set"}})')
 for m in state['monitors']:
  if m['name'] not in names:continue
  codes.extend([f'hl.dsp.focus({{monitor={quote(m["name"])}}})',f'hl.dsp.focus({{workspace={m["workspace"]}}})'])
  if m['special']:
   now=next(a for a in get('monitors') if a['name']==m['name'])
   if not now['specialWorkspace'].get('name'):codes.append('hl.dsp.workspace.toggle_special('+quote(m['special'].removeprefix('special:'))+')')
 active=state.get('focus');w=live.get(active.get('address')) if active else None
 if active and same_window(active,w):codes.append(f'hl.dsp.focus({{window="address:{active["address"]}"}})')
 else:codes.append(f'hl.dsp.focus({{monitor={quote(MAIN)}}})')
 if codes:batch(codes)
 final={w['address']:w for w in get('clients')}
 if any(same_window(r,final.get(r['address'])) and final[r['address']]['workspace'].get('id')!=r['workspace'] for r in rows):raise RuntimeError('Some windows did not return; recovery state was retained.')
 p.unlink()
def gather(restore_only=False):
 p=RUN/'gather.json';m=mon()
 if not m:note('Preferred output is unavailable; no windows were moved.');return
 if p.exists():
  state=json.loads(p.read_text())
  if state['session']!=os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):p.unlink();note('Discarded a stale gather toggle from a previous session.');return
  if state.get('kind')=='visible-windows':restore_collection(state,p);return
  # Complete any still-pending toggle from the previous single-workspace implementation.
  if not mon(state['origin']):note('The original output is unavailable; keeping the prior recovery state.');return
  batch([f'hl.dsp.workspace.move({{workspace={state["workspace"]},monitor={quote(state["origin"])}}})',f'hl.dsp.focus({{monitor={quote(MAIN)}}})',f'hl.dsp.focus({{workspace={state["main_before"]}}})',f'hl.dsp.focus({{monitor={quote(state["origin"])}}})',f'hl.dsp.focus({{workspace={state["workspace"]}}})'])
  p.unlink();return
 if restore_only:return
 monitors=get('monitors');byid={a['id']:a for a in monitors};ids={a['activeWorkspace']['id'] for a in monitors};clients=get('clients')
 visible=[w for w in clients if w['mapped'] and w['workspace'].get('id') in ids and (not w.get('hidden') or w.get('grouped'))]
 if not visible:note('There are no application windows on the visible normal workspaces.');return
 target=m['activeWorkspace']['id']
 if not any(w['workspace'].get('id')!=target for w in visible):note('The visible application windows are already together on the preferred output.');return
 rows=[{**{k:w.get(k) for k in ['address','pid','class','at','size','floating','fullscreen','grouped','hidden']},'workspace':w['workspace']['id'],'output':byid[w['monitor']]['name']} for w in visible]
 active=get('activewindow');state={'kind':'visible-windows','session':os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'),'main_workspace':target,'focus':{k:active.get(k) for k in ['address','pid','class']} if active else None,'monitors':[{'name':a['name'],'workspace':a['activeWorkspace']['id'],'special':a['specialWorkspace'].get('name','')} for a in monitors],'windows':rows};atomic(p,state)
 try:
  unfullscreen(rows,{w['address']:w for w in clients});codes=[]
  for a in monitors:
   if a['specialWorkspace'].get('name'):codes.extend([f'hl.dsp.focus({{monitor={quote(a["name"])}}})','hl.dsp.workspace.toggle_special('+quote(a['specialWorkspace']['name'].removeprefix('special:'))+')'])
  for row in representatives(rows):
   if row['workspace']==target:continue
   codes.append(f'hl.dsp.window.move({{window="address:{row["address"]}",workspace={target},follow=false}})')
   if row['floating']:
    xx=m['x']+max(72,min(row['at'][0]-byid[next(w['monitor'] for w in clients if w['address']==row['address'])]['x'],round(m['width']/m.get('scale',1))-row['size'][0]-16));yy=m['y']+max(24,min(row['at'][1],round(m['height']/m.get('scale',1))-row['size'][1]-16))
    codes.append(f'hl.dsp.window.move({{window="address:{row["address"]}",x={xx},y={yy},relative=false}})')
  codes.extend([f'hl.dsp.focus({{monitor={quote(MAIN)}}})',f'hl.dsp.focus({{workspace={target}}})'])
  if active.get('address') in {r['address'] for r in rows}:codes.append(f'hl.dsp.focus({{window="address:{active["address"]}"}})')
  batch(codes)
  final={w['address']:w for w in get('clients')}
  if any(same_window(r,final.get(r['address'])) and final[r['address']]['workspace'].get('id')!=target for r in rows):raise RuntimeError('Some windows did not gather; press Super+D to restore the saved locations.')
 except Exception:
  note('Gather did not finish. Saved original locations were retained; press Super+D to recover.');raise

def main():
 op=sys.argv[1]
 lock=RUN/('arch.lock' if op in ['arch','close-arch'] else 'gather.lock')
 with lock.open('w') as f:
  try:fcntl.flock(f,fcntl.LOCK_EX|fcntl.LOCK_NB)
  except BlockingIOError:return
  if op=='arch':arch()
  elif op=='close-arch':close_arch()
  elif op=='gather':gather()
  elif op=='restore':gather(True)
if __name__=='__main__':main()
