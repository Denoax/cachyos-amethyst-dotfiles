#!/usr/bin/env python3
from pathlib import Path
import os
import tempfile

home = Path.home()
destination = home / '.local/state/caelestia/scheme.json'
source = home / '.local/share/caelestia-monochrome/palette.json'
palette = source.read_bytes()
if not destination.is_file() or destination.read_bytes() != palette:
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=destination.parent, delete=False) as temporary:
        try:
            temporary.write(palette)
            temporary.flush()
            os.replace(temporary.name, destination)
        finally:
            Path(temporary.name).unlink(missing_ok=True)
