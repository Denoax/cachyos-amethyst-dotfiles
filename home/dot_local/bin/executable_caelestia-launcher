#!/usr/bin/env python3
"""Show the existing Caelestia launcher, including from fullscreen apps."""
import json,subprocess,time

def run(*args):
    return subprocess.check_output(args,text=True).strip()

def ipc(*args):
    return run("caelestia","shell",*args)

def get(name):
    return json.loads(run("hyprctl",name,"-j"))

if ipc("lock","isLocked") != "false":
    raise SystemExit(0)
if ipc("drawers","isOpen","launcher") == "1":
    ipc("drawers","toggle","launcher")
    raise SystemExit(0)
# Upstream refuses the launcher while this workspace has a fullscreen window.
active = get("activewindow")
workspace = active.get("workspace",get("activeworkspace")).get("address")
for window in get("clients"):
    if window["workspace"].get("address") == workspace and window.get("fullscreen",0) > 1:
        address = window["address"]
        run("hyprctl","dispatch",'hl.dsp.window.fullscreen({window="address:'+address+'",action="unset"})')
# Wait briefly for Caelestia's Hyprland model to observe the fullscreen change.
for attempt in range(20):
    if ipc("drawers","isOpen","launcher") == "1":
        break
    ipc("drawers","toggle","launcher")
    time.sleep(.05)
else:
    raise SystemExit("Caelestia did not open its launcher.")
