{
  "name": "Amethyst CP",
  "settings": "{\"settings\": \"{\\\"editor.fontSize\\\": 14, \\\"editor.fontLigatures\\\": false, \\\"editor.tabSize\\\": 4, \\\"editor.insertSpaces\\\": true, \\\"editor.minimap.enabled\\\": false, \\\"editor.stickyScroll.enabled\\\": false, \\\"editor.inlayHints.enabled\\\": \\\"off\\\", \\\"workbench.editor.enablePreview\\\": false, \\\"files.autoSave\\\": \\\"off\\\", \\\"editor.formatOnSave\\\": false, \\\"files.encoding\\\": \\\"utf8\\\", \\\"files.eol\\\": \\\"\\\\n\\\", \\\"files.insertFinalNewline\\\": true, \\\"editor.tabCompletion\\\": \\\"off\\\", \\\"C_Cpp.default.compilerPath\\\": \\\"g++\\\", \\\"C_Cpp.default.cppStandard\\\": \\\"c++23\\\", \\\"C_Cpp.default.cStandard\\\": \\\"c17\\\", \\\"C_Cpp.clang_format_path\\\": \\\"clang-format\\\", \\\"C_Cpp.intelliSenseEngine\\\": \\\"default\\\", \\\"python.defaultInterpreterPath\\\": \\\"python3\\\", \\\"python.analysis.diagnosticMode\\\": \\\"openFilesOnly\\\", \\\"[python]\\\": {\\\"editor.defaultFormatter\\\": \\\"ms-python.black-formatter\\\"}, \\\"[cpp]\\\": {\\\"editor.defaultFormatter\\\": \\\"ms-vscode.cpptools\\\"}, \\\"[c]\\\": {\\\"editor.defaultFormatter\\\": \\\"ms-vscode.cpptools\\\"}, \\\"java.autobuild.enabled\\\": false, \\\"java.import.maven.enabled\\\": false, \\\"java.import.gradle.enabled\\\": false, \\\"java.debug.settings.console\\\": \\\"integratedTerminal\\\", \\\"debug.onTaskErrors\\\": \\\"abort\\\", \\\"files.watcherExclude\\\": {\\\"**/.build/**\\\": true, \\\"**/.toolchains/**\\\": true, \\\"**/.git/**\\\": true, \\\"**/.cp-selected/**\\\": true}, \\\"search.exclude\\\": {\\\"**/.build\\\": true, \\\"**/.toolchains\\\": true, \\\"**/.cp-selected\\\": true}, \\\"java.import.exclusions\\\": [\\\"**/.toolchains/**\\\", \\\"**/.build/**\\\", \\\"**/templates/**\\\"], \\\"C_Cpp.files.exclude\\\": {\\\"**/.toolchains/**\\\": true, \\\"**/.build/**\\\": true}, \\\"python.analysis.exclude\\\": [\\\"**/.toolchains/**\\\", \\\"**/.build/**\\\"], \\\"workbench.startupEditor\\\": \\\"none\\\", \\\"workbench.colorTheme\\\": \\\"Monochromator Dark Amethyst\\\", \\\"task.saveBeforeRun\\\": \\\"always\\\", \\\"C_Cpp.default.browse.path\\\": [\\\"${workspaceFolder}/.cp-selected\\\"], \\\"C_Cpp.default.browse.limitSymbolsToIncludedHeaders\\\": true, \\\"java.configuration.updateBuildConfiguration\\\": \\\"disabled\\\", \\\"java.project.sourcePaths\\\": [\\\".cp-selected\\\"], \\\"java.project.outputPath\\\": \\\".build/java-language-server\\\", \\\"java.project.referencedLibraries\\\": [], \\\"java.inlayHints.parameterNames.enabled\\\": \\\"none\\\", \\\"java.debug.settings.showInlineValues\\\": false, \\\"explorer.confirmDelete\\\": false, \\\"workbench.colorCustomizations\\\": {\\\"[Monochromator Dark Amethyst]\\\": {\\\"titleBar.activeBackground\\\": \\\"#08080a\\\", \\\"titleBar.inactiveBackground\\\": \\\"#08080a\\\", \\\"activityBar.background\\\": \\\"#08080a\\\", \\\"activityBarTop.background\\\": \\\"#08080a\\\", \\\"editorGroupHeader.tabsBackground\\\": \\\"#08080a\\\", \\\"editorGroupHeader.noTabsBackground\\\": \\\"#08080a\\\", \\\"statusBar.background\\\": \\\"#08080a\\\", \\\"statusBar.noFolderBackground\\\": \\\"#08080a\\\", \\\"statusBar.debuggingBackground\\\": \\\"#08080a\\\", \\\"statusBarItem.remoteBackground\\\": \\\"#08080a\\\", \\\"sideBar.background\\\": \\\"#0c0b0f\\\", \\\"sideBarSectionHeader.background\\\": \\\"#0c0b0f\\\", \\\"panel.background\\\": \\\"#0c0b0f\\\", \\\"panelSectionHeader.background\\\": \\\"#0c0b0f\\\", \\\"tab.inactiveBackground\\\": \\\"#0c0b0f\\\", \\\"tab.unfocusedInactiveBackground\\\": \\\"#0c0b0f\\\", \\\"editorGroup.border\\\": \\\"#1b1720\\\", \\\"editorGroupHeader.tabsBorder\\\": \\\"#1b1720\\\", \\\"sideBar.border\\\": \\\"#1b1720\\\", \\\"sideBarSectionHeader.border\\\": \\\"#1b1720\\\", \\\"panel.border\\\": \\\"#1b1720\\\", \\\"panelSection.border\\\": \\\"#1b1720\\\", \\\"titleBar.border\\\": \\\"#1b1720\\\", \\\"statusBar.border\\\": \\\"#1b1720\\\", \\\"tab.border\\\": \\\"#1b1720\\\", \\\"tab.activeBackground\\\": \\\"#08080a\\\", \\\"tab.unfocusedActiveBackground\\\": \\\"#08080a\\\", \\\"editorGroup.emptyBackground\\\": \\\"#08080a\\\", \\\"tab.hoverBackground\\\": \\\"#17101d\\\", \\\"tab.unfocusedHoverBackground\\\": \\\"#17101d\\\", \\\"toolbar.hoverBackground\\\": \\\"#17101d\\\", \\\"statusBarItem.hoverBackground\\\": \\\"#17101d\\\", \\\"editorWidget.background\\\": \\\"#0e0c12\\\", \\\"editorHoverWidget.background\\\": \\\"#0e0c12\\\", \\\"quickInput.background\\\": \\\"#0e0c12\\\", \\\"dropdown.background\\\": \\\"#0e0c12\\\", \\\"input.background\\\": \\\"#0e0c12\\\", \\\"menu.background\\\": \\\"#0e0c12\\\", \\\"notifications.background\\\": \\\"#0e0c12\\\", \\\"editorWidget.border\\\": \\\"#251c2c\\\", \\\"editorHoverWidget.border\\\": \\\"#251c2c\\\", \\\"dropdown.border\\\": \\\"#251c2c\\\", \\\"input.border\\\": \\\"#251c2c\\\", \\\"menu.border\\\": \\\"#251c2c\\\", \\\"notifications.border\\\": \\\"#251c2c\\\", \\\"commandCenter.border\\\": \\\"#251c2c\\\", \\\"commandCenter.background\\\": \\\"#0c0b0f\\\", \\\"tab.activeBorderTop\\\": \\\"#ac79c4\\\", \\\"panelTitle.activeBorder\\\": \\\"#ac79c4\\\", \\\"activityBar.activeBorder\\\": \\\"#ac79c4\\\", \\\"tab.unfocusedActiveBorderTop\\\": \\\"#553762\\\", \\\"tab.activeForeground\\\": \\\"#d0b2e0\\\", \\\"panelTitle.activeForeground\\\": \\\"#d0b2e0\\\", \\\"activityBar.activeForeground\\\": \\\"#d0b2e0\\\", \\\"activityBar.foreground\\\": \\\"#d0b2e0\\\", \\\"focusBorder\\\": \\\"#9361ad\\\", \\\"commandCenter.activeBorder\\\": \\\"#85549c\\\", \\\"list.activeSelectionBackground\\\": \\\"#25182f\\\", \\\"list.focusBackground\\\": \\\"#25182f\\\", \\\"quickInputList.focusBackground\\\": \\\"#25182f\\\", \\\"list.inactiveSelectionBackground\\\": \\\"#1a1221\\\", \\\"list.hoverBackground\\\": \\\"#151019\\\", \\\"list.highlightForeground\\\": \\\"#c99be0\\\", \\\"list.focusHighlightForeground\\\": \\\"#c99be0\\\", \\\"list.focusOutline\\\": \\\"#9361ad80\\\", \\\"activityBarBadge.background\\\": \\\"#b58aca\\\", \\\"badge.background\\\": \\\"#b58aca\\\", \\\"activityBarBadge.foreground\\\": \\\"#08080a\\\", \\\"badge.foreground\\\": \\\"#08080a\\\", \\\"button.background\\\": \\\"#3b2348\\\", \\\"button.hoverBackground\\\": \\\"#50305f\\\", \\\"button.foreground\\\": \\\"#eadff0\\\", \\\"button.secondaryBackground\\\": \\\"#1b1422\\\", \\\"button.secondaryHoverBackground\\\": \\\"#2a1c34\\\", \\\"progressBar.background\\\": \\\"#ac79c4\\\"}}, \\\"files.exclude\\\": {\\\"**/.build\\\": true, \\\"**/.toolchains\\\": true}, \\\"github.copilot.enable\\\": {\\\"*\\\": false, \\\"plaintext\\\": false, \\\"markdown\\\": false, \\\"scminput\\\": false}, \\\"workbench.enableExperiments\\\": false}\"}",
  "keybindings": "{\"keybindings\": \"[{\\\"key\\\": \\\"f6\\\", \\\"command\\\": \\\"workbench.action.tasks.runTask\\\", \\\"args\\\": \\\"CP: Run input\\\", \\\"when\\\": \\\"workspaceFolderCount > 0 && (resourcePath =~ /problems/ || terminalFocus)\\\"}, {\\\"key\\\": \\\"shift+f6\\\", \\\"command\\\": \\\"workbench.action.tasks.runTask\\\", \\\"args\\\": \\\"CP: Run interactive\\\", \\\"when\\\": \\\"workspaceFolderCount > 0 && (resourcePath =~ /problems/ || terminalFocus)\\\"}, {\\\"key\\\": \\\"ctrl+shift+f6\\\", \\\"command\\\": \\\"workbench.action.tasks.runTask\\\", \\\"args\\\": \\\"CP: Sanitize samples\\\", \\\"when\\\": \\\"workspaceFolderCount > 0 && (resourcePath =~ /problems/ || terminalFocus)\\\"}, {\\\"key\\\": \\\"ctrl+alt+n\\\", \\\"command\\\": \\\"workbench.action.tasks.runTask\\\", \\\"args\\\": \\\"CP: New problem\\\", \\\"when\\\": \\\"workspaceFolderCount > 0 && (resourcePath =~ /problems/ || terminalFocus)\\\"}, {\\\"key\\\": \\\"ctrl+f5\\\", \\\"command\\\": \\\"workbench.action.tasks.runTask\\\", \\\"args\\\": \\\"CP: Run interactive\\\", \\\"when\\\": \\\"workspaceFolderCount > 0 && (resourcePath =~ /problems/ || terminalFocus)\\\"}, {\\\"key\\\": \\\"ctrl+k r\\\", \\\"command\\\": \\\"editor.action.startFindReplaceAction\\\", \\\"when\\\": \\\"editorFocus && resourcePath =~ /problems/\\\"}, {\\\"key\\\": \\\"ctrl+shift+b\\\", \\\"command\\\": \\\"workbench.action.tasks.runTask\\\", \\\"args\\\": \\\"CP: Build\\\", \\\"when\\\": \\\"workspaceFolderCount > 0 && (resourcePath =~ /problems/ || terminalFocus)\\\"}, {\\\"key\\\": \\\"ctrl+alt+c\\\", \\\"command\\\": \\\"workbench.action.tasks.runTask\\\", \\\"args\\\": \\\"CP: Copy submission\\\", \\\"when\\\": \\\"workspaceFolderCount > 0 && (resourcePath =~ /problems/ || terminalFocus)\\\"}, {\\\"key\\\": \\\"shift+alt+f\\\", \\\"command\\\": \\\"-editor.action.formatDocument\\\"}]\"}",
  "snippets": "{\"snippets\": {\"cp.code-snippets\": \"{\\n    \\\"BFS (0-based unweighted graph)\\\": {\\n        \\\"scope\\\": \\\"cpp\\\",\\n        \\\"prefix\\\": \\\"cp-bfs\\\",\\n        \\\"body\\\": [\\n            \\\"// adj: 0-based adjacency list, start in [0,n); -1 means unreachable.\\\",\\n            \\\"std::vector<int> dist(adj.size(), -1);\\\",\\n            \\\"std::queue<int> q;\\\",\\n            \\\"dist[start] = 0; q.push(start);\\\",\\n            \\\"while (!q.empty()) {\\\",\\n            \\\"    int u = q.front(); q.pop();\\\",\\n            \\\"    for (int v : adj[u]) if (dist[v] == -1) {\\\",\\n            \\\"        dist[v] = dist[u] + 1; q.push(v);\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"BFS (0-based unweighted graph); original local implementation\\\"\\n    },\\n    \\\"Iterative DFS (0-based)\\\": {\\n        \\\"scope\\\": \\\"cpp\\\",\\n        \\\"prefix\\\": \\\"cp-dfs\\\",\\n        \\\"body\\\": [\\n            \\\"// adj: 0-based adjacency list. Mark when pushed to avoid duplicate work.\\\",\\n            \\\"std::vector<bool> seen(adj.size(), false);\\\",\\n            \\\"std::vector<int> stack{start}; seen[start] = true;\\\",\\n            \\\"while (!stack.empty()) {\\\",\\n            \\\"    int u = stack.back(); stack.pop_back();\\\",\\n            \\\"    for (int v : adj[u]) if (!seen[v]) {\\\",\\n            \\\"        seen[v] = true; stack.push_back(v);\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Iterative DFS (0-based); original local implementation\\\"\\n    },\\n    \\\"Dijkstra (nonnegative weights)\\\": {\\n        \\\"scope\\\": \\\"cpp\\\",\\n        \\\"prefix\\\": \\\"cp-dijkstra\\\",\\n        \\\"body\\\": [\\n            \\\"// adj[u]: pairs (v, weight); 0 <= weight < INF; paths >= INF are unsupported.\\\",\\n            \\\"using Item = std::pair<long long, int>;\\\",\\n            \\\"const long long INF = std::numeric_limits<long long>::max() / 4;\\\",\\n            \\\"std::vector<long long> dist(adj.size(), INF);\\\",\\n            \\\"std::priority_queue<Item, std::vector<Item>, std::greater<Item>> pq;\\\",\\n            \\\"dist[start] = 0; pq.push({0, start});\\\",\\n            \\\"while (!pq.empty()) {\\\",\\n            \\\"    auto [du, u] = pq.top(); pq.pop();\\\",\\n            \\\"    if (du != dist[u]) continue;\\\",\\n            \\\"    for (auto [v, w] : adj[u]) {\\\",\\n            \\\"        if (w < 0 || w >= INF || du > INF - w) continue;\\\",\\n            \\\"        if (du + w < dist[v]) {\\\",\\n            \\\"            dist[v] = du + w; pq.push({dist[v], v});\\\",\\n            \\\"        }\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Dijkstra (nonnegative weights); original local implementation\\\"\\n    },\\n    \\\"DSU (0-based)\\\": {\\n        \\\"scope\\\": \\\"cpp\\\",\\n        \\\"prefix\\\": \\\"cp-dsu\\\",\\n        \\\"body\\\": [\\n            \\\"// Requires <numeric>; indices [0,n). Union by size with path compression.\\\",\\n            \\\"struct DSU {\\\",\\n            \\\"    std::vector<int> p, size;\\\",\\n            \\\"    explicit DSU(int n) : p(n), size(n, 1) { std::iota(p.begin(), p.end(), 0); }\\\",\\n            \\\"    int find(int x) {\\\",\\n            \\\"        while (p[x] != x) { p[x] = p[p[x]]; x = p[x]; }\\\",\\n            \\\"        return x;\\\",\\n            \\\"    }\\\",\\n            \\\"    bool unite(int a, int b) {\\\",\\n            \\\"        a = find(a); b = find(b);\\\",\\n            \\\"        if (a == b) return false;\\\",\\n            \\\"        if (size[a] < size[b]) std::swap(a, b);\\\",\\n            \\\"        p[b] = a; size[a] += size[b]; return true;\\\",\\n            \\\"    }\\\",\\n            \\\"};\\\"\\n        ],\\n        \\\"description\\\": \\\"DSU (0-based); original local implementation\\\"\\n    },\\n    \\\"Fenwick (0-based public API)\\\": {\\n        \\\"scope\\\": \\\"cpp\\\",\\n        \\\"prefix\\\": \\\"cp-fenwick\\\",\\n        \\\"body\\\": [\\n            \\\"// add(i,delta): 0 <= i < n. prefix(end): sum [0,end), 0 <= end <= n.\\\",\\n            \\\"struct Fenwick {\\\",\\n            \\\"    std::vector<long long> bit;\\\",\\n            \\\"    explicit Fenwick(int n) : bit(n + 1, 0) {}\\\",\\n            \\\"    void add(int i, long long delta) {\\\",\\n            \\\"        for (++i; i < static_cast<int>(bit.size()); i += i & -i) bit[i] += delta;\\\",\\n            \\\"    }\\\",\\n            \\\"    long long prefix(int end) const {\\\",\\n            \\\"        long long result = 0;\\\",\\n            \\\"        for (int i = end; i > 0; i -= i & -i) result += bit[i];\\\",\\n            \\\"        return result;\\\",\\n            \\\"    }\\\",\\n            \\\"};\\\"\\n        ],\\n        \\\"description\\\": \\\"Fenwick (0-based public API); original local implementation\\\"\\n    },\\n    \\\"Modular exponentiation (portable bounded modulus)\\\": {\\n        \\\"scope\\\": \\\"cpp\\\",\\n        \\\"prefix\\\": \\\"cp-modpow\\\",\\n        \\\"body\\\": [\\n            \\\"// 1 <= mod <= 2^31-1; exp >= 0. Products fit signed long long.\\\",\\n            \\\"long long modpow(long long base, long long exp, long long mod) {\\\",\\n            \\\"    base %= mod; if (base < 0) base += mod;\\\",\\n            \\\"    long long result = 1 % mod;\\\",\\n            \\\"    while (exp > 0) {\\\",\\n            \\\"        if (exp & 1) result = result * base % mod;\\\",\\n            \\\"        base = base * base % mod; exp >>= 1;\\\",\\n            \\\"    }\\\",\\n            \\\"    return result;\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Modular exponentiation (portable bounded modulus); original local implementation\\\"\\n    }\\n}\\n\"}}",
  "extensions": "[{\"identifier\": {\"id\": \"beem.monochromator\"}, \"disabled\": false}, {\"identifier\": {\"id\": \"ms-vscode.cpptools\"}, \"disabled\": false}, {\"identifier\": {\"id\": \"ms-python.python\"}, \"disabled\": false}, {\"identifier\": {\"id\": \"ms-python.vscode-pylance\"}, \"disabled\": false}, {\"identifier\": {\"id\": \"ms-python.debugpy\"}, \"disabled\": false}, {\"identifier\": {\"id\": \"ms-python.black-formatter\"}, \"disabled\": false}, {\"identifier\": {\"id\": \"redhat.java\"}, \"disabled\": false}, {\"identifier\": {\"id\": \"vscjava.vscode-java-debug\"}, \"disabled\": false}]"
