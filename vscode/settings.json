{
  "editor.fontSize": 14,
  "editor.fontLigatures": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.inlayHints.enabled": "off",
  "workbench.editor.enablePreview": false,
  "files.autoSave": "off",
  "editor.formatOnSave": false,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "editor.tabCompletion": "off",
  "C_Cpp.default.compilerPath": "g++",
  "C_Cpp.default.cppStandard": "c++23",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.clang_format_path": "clang-format",
  "C_Cpp.intelliSenseEngine": "default",
  "python.defaultInterpreterPath": "python3",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "java.autobuild.enabled": false,
  "java.import.maven.enabled": false,
  "java.import.gradle.enabled": false,
  "java.debug.settings.console": "integratedTerminal",
  "debug.onTaskErrors": "abort",
  "files.watcherExclude": {
    "**/.build/**": true,
    "**/.toolchains/**": true,
    "**/.git/**": true,
    "**/.cp-selected/**": true
  },
  "search.exclude": {
    "**/.build": true,
    "**/.toolchains": true,
    "**/.cp-selected": true
  },
  "java.import.exclusions": [
    "**/.toolchains/**",
    "**/.build/**",
    "**/templates/**"
  ],
  "C_Cpp.files.exclude": {
    "**/.toolchains/**": true,
    "**/.build/**": true
  },
  "python.analysis.exclude": [
    "**/.toolchains/**",
    "**/.build/**"
  ],
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Monochromator Dark Amethyst",
  "task.saveBeforeRun": "always",
  "C_Cpp.default.browse.path": [
    "${workspaceFolder}/.cp-selected"
  ],
  "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": true,
  "java.configuration.updateBuildConfiguration": "disabled",
  "java.project.sourcePaths": [
    ".cp-selected"
  ],
  "java.project.outputPath": ".build/java-language-server",
  "java.project.referencedLibraries": [],
  "java.inlayHints.parameterNames.enabled": "none",
  "java.debug.settings.showInlineValues": false,
  "explorer.confirmDelete": false,
  "workbench.colorCustomizations": {
    "[Monochromator Dark Amethyst]": {
      "titleBar.activeBackground": "#08080a",
      "titleBar.inactiveBackground": "#08080a",
      "activityBar.background": "#08080a",
      "activityBarTop.background": "#08080a",
      "editorGroupHeader.tabsBackground": "#08080a",
      "editorGroupHeader.noTabsBackground": "#08080a",
      "statusBar.background": "#08080a",
      "statusBar.noFolderBackground": "#08080a",
      "statusBar.debuggingBackground": "#08080a",
      "statusBarItem.remoteBackground": "#08080a",
      "sideBar.background": "#0c0b0f",
      "sideBarSectionHeader.background": "#0c0b0f",
      "panel.background": "#0c0b0f",
      "panelSectionHeader.background": "#0c0b0f",
      "tab.inactiveBackground": "#0c0b0f",
      "tab.unfocusedInactiveBackground": "#0c0b0f",
      "editorGroup.border": "#1b1720",
      "editorGroupHeader.tabsBorder": "#1b1720",
      "sideBar.border": "#1b1720",
      "sideBarSectionHeader.border": "#1b1720",
      "panel.border": "#1b1720",
      "panelSection.border": "#1b1720",
      "titleBar.border": "#1b1720",
      "statusBar.border": "#1b1720",
      "tab.border": "#1b1720",
      "tab.activeBackground": "#08080a",
      "tab.unfocusedActiveBackground": "#08080a",
      "editorGroup.emptyBackground": "#08080a",
      "tab.hoverBackground": "#17101d",
      "tab.unfocusedHoverBackground": "#17101d",
      "toolbar.hoverBackground": "#17101d",
      "statusBarItem.hoverBackground": "#17101d",
      "editorWidget.background": "#0e0c12",
      "editorHoverWidget.background": "#0e0c12",
      "quickInput.background": "#0e0c12",
      "dropdown.background": "#0e0c12",
      "input.background": "#0e0c12",
      "menu.background": "#0e0c12",
      "notifications.background": "#0e0c12",
      "editorWidget.border": "#251c2c",
      "editorHoverWidget.border": "#251c2c",
      "dropdown.border": "#251c2c",
      "input.border": "#251c2c",
      "menu.border": "#251c2c",
      "notifications.border": "#251c2c",
      "commandCenter.border": "#251c2c",
      "commandCenter.background": "#0c0b0f",
      "tab.activeBorderTop": "#ac79c4",
      "panelTitle.activeBorder": "#ac79c4",
      "activityBar.activeBorder": "#ac79c4",
      "tab.unfocusedActiveBorderTop": "#553762",
      "tab.activeForeground": "#d0b2e0",
      "panelTitle.activeForeground": "#d0b2e0",
      "activityBar.activeForeground": "#d0b2e0",
      "activityBar.foreground": "#d0b2e0",
      "focusBorder": "#9361ad",
      "commandCenter.activeBorder": "#85549c",
      "list.activeSelectionBackground": "#25182f",
      "list.focusBackground": "#25182f",
      "quickInputList.focusBackground": "#25182f",
      "list.inactiveSelectionBackground": "#1a1221",
      "list.hoverBackground": "#151019",
      "list.highlightForeground": "#c99be0",
      "list.focusHighlightForeground": "#c99be0",
      "list.focusOutline": "#9361ad80",
      "activityBarBadge.background": "#b58aca",
      "badge.background": "#b58aca",
      "activityBarBadge.foreground": "#08080a",
      "badge.foreground": "#08080a",
      "button.background": "#3b2348",
      "button.hoverBackground": "#50305f",
      "button.foreground": "#eadff0",
      "button.secondaryBackground": "#1b1422",
      "button.secondaryHoverBackground": "#2a1c34",
      "progressBar.background": "#ac79c4"
    }
  },
  "files.exclude": {
    "**/.build": true,
    "**/.toolchains": true
  },
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "workbench.enableExperiments": false
}
