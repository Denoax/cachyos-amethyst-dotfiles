{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CP: Build",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/cpw.py",
        "build",
        "--context",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CP: Run input",
      "type": "process",
