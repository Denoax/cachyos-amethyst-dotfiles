#!/usr/bin/env python3
"""Local source, data-boundary, license, action-pin and documentation checks."""
import ast
import hashlib
import json
from pathlib import Path
import re
import subprocess

ROOT=Path(__file__).resolve().parents[1]
files=[ROOT/p for p in subprocess.check_output(['git','-C',str(ROOT),'ls-files'],text=True).splitlines()]
errors=[]
for p in files:
    if not p.exists():errors.append('missing tracked file '+str(p.relative_to(ROOT)));continue
    rel=str(p.relative_to(ROOT))
    # The full natural-cycle README banner has a narrow measured allowance.
    limit=12*1024*1024 if rel=='site/public/media/banner.gif' else 8*1024*1024
    if p.stat().st_size>limit:errors.append('oversized Git asset '+rel)
    try:s=p.read_text()
    except UnicodeDecodeError:continue
    if re.search(r'/home/[A-Za-z][A-Za-z0-9_.-]*/',s):errors.append('absolute source-user path '+rel)
    if re.search(r'(?:gh[pousr]_[A-Za-z0-9]{25,}|github_pat_[A-Za-z0-9_]{30,}|-----BEGIN (?:OPENSSH|RSA|EC) PRIVATE KEY-----)',s):errors.append('credential-like data '+rel)
    try:
        if p.suffix=='.py' or s.startswith('#!/usr/bin/env python3'):ast.parse(s,rel)
        if p.suffix in ['.json','.code-profile'] or p.name.endswith('.json.tmpl'):json.loads(s)
    except (SyntaxError,ValueError) as exc:errors.append(rel+': '+str(exc))
    if p.suffix=='.md':
        for target in re.findall(r'\]\(([^ )]+)(?:\s+"[^"]*")?\)',s):
            if target.startswith(('http:','https:','mailto:','#','/')):continue
            target=target.split('#')[0]
            if target and not (p.parent/target).exists():errors.append(rel+' broken local link '+target)
    if '.github/workflows/' in rel:
        for action in re.findall(r'uses:\s*([^\s]+)',s):
            if not action.startswith('./') and not re.search(r'@[a-f0-9]{40}$',action):errors.append('unpinned action '+action)
for name in ['LICENSE','LICENSES/Caelestia-GPL-3.0.txt','LICENSES/CachyOS-GPL-1.0.txt','LICENSES/Konata-MIT.txt']:
    if not (ROOT/name).is_file():errors.append('missing license '+name)
patch=ROOT/'patches/caelestia-2.5.0.patch'
if hashlib.sha256(patch.read_bytes()).hexdigest()!=json.loads((ROOT/'patches/caelestia-base.json').read_text())['patch_sha256']:errors.append('patch checksum mismatch')
subprocess.run(['sh','-n',str(ROOT/'install.sh')],check=True)
profile=json.loads((ROOT/'vscode/Amethyst.code-profile').read_text())
assert json.loads(json.loads(profile['settings'])['settings'])==json.loads((ROOT/'vscode/settings.json').read_text())
assert len(json.loads(profile['extensions']))==len(json.loads((ROOT/'vscode/extensions.json').read_text()))
if errors:raise SystemExit('\n'.join(errors))
print('PASS syntax, JSON/profile, private-data patterns, local links, license files, patch checksum and action pins')
