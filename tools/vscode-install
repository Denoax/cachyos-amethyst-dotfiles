#!/usr/bin/env python3
"""Install the official Microsoft archive as this user, checking vendor SHA-256."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import tarfile
import tempfile
import urllib.request

p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--check',action='store_true',help='fetch and print current vendor metadata without installing')
a=p.parse_args()
if os.geteuid()==0:raise SystemExit('Run as an ordinary user')
url='https://update.code.visualstudio.com/api/update/linux-x64/stable/latest'
metadata=json.load(urllib.request.urlopen(url,timeout=30))
version=metadata['productVersion'];expected=metadata['sha256hash']
if a.check:
    print(json.dumps({k:metadata[k] for k in ['productVersion','version','url','sha256hash']},indent=2));raise SystemExit(0)
target=Path.home()/'.local/opt'/('vscode-ms-'+version)
if target.exists():raise SystemExit('Version already exists; inspect it before changing the stable pointer: '+str(target))
print('Official Microsoft archive:',metadata['url'],'version:',version,'SHA-256:',expected)
with tempfile.TemporaryDirectory(prefix='amethyst-vscode-') as d:
    archive=Path(d)/'vscode.tar.gz';urllib.request.urlretrieve(metadata['url'],archive)
    if hashlib.sha256(archive.read_bytes()).hexdigest()!=expected:raise SystemExit('Vendor checksum mismatch')
    target.parent.mkdir(parents=True,exist_ok=True)
    with tarfile.open(archive) as tf:tf.extractall(target,filter='data')
    product=json.loads((target/'VSCode-linux-x64/resources/app/product.json').read_text())
    if product['nameLong']!='Visual Studio Code' or product['quality']!='stable':raise SystemExit('Unexpected Microsoft product identity')
    (target/'download-provenance.json').write_text(json.dumps(metadata,indent=2))
link=target.parent/'vscode-ms'
if link.exists() or link.is_symlink():
    print('Installed without changing existing stable pointer. Close Microsoft windows before switching:',link,'->',target/'VSCode-linux-x64')
else:
    link.symlink_to(target/'VSCode-linux-x64',target_is_directory=True)
    print('Installed:',link/'bin/code')
