    if meta.get('interrupted'):raise SystemExit('An interrupted rehearsal cannot be published as a completed feature')
    workflow=source.parent/'workflow.json'
    if workflow.exists() and json.loads(workflow.read_text())['status']!='PASS':raise SystemExit('The recorded workflow did not complete; publication refused')
    if sha(source)!=meta['sha256']:raise SystemExit('Source hash changed; publication refused')
