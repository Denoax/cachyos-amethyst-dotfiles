def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def save(p,data):p.write_text(json.dumps(data,indent=2)+'\n')
def webp_info(path):
    data=path.read_bytes()
    if data[:4]!=b'RIFF' or data[8:12]!=b'WEBP' or struct.unpack('<I',data[4:8])[0]+8!=len(data):raise ValueError('Invalid WebP container')
    offset=12;frames=0;duration=0;canvas=None
    while offset+8<=len(data):
        kind=data[offset:offset+4];size=struct.unpack('<I',data[offset+4:offset+8])[0];payload=data[offset+8:offset+8+size]
        if len(payload)!=size:raise ValueError('Truncated WebP chunk')
        if kind==b'VP8X':canvas=[int.from_bytes(payload[4:7],'little')+1,int.from_bytes(payload[7:10],'little')+1]
        if kind==b'ANMF':frames+=1;duration+=int.from_bytes(payload[12:15],'little')
        offset+=8+size+(size%2)
    if not frames or not canvas:raise ValueError('Expected animated WebP')
    return {'frames':frames,'duration_seconds':duration/1000,'canvas':canvas}
def gif_filter(a):
    # Palette-analysis weighting reserves the source theme's sparse purple. The
    # delivered frame stream [b] is untouched; no UI colors are painted over it.
    bias='drawbox=x=0:y=0:w=iw:h=16:color=0xd559ff:t=fill,drawbox=x=0:y=16:w=iw:h=16:color=0xac79c4:t=fill,' if a.reserve_accent else ''
    return f'fps={a.gif_fps},scale={a.gif_width}:-1:flags=lanczos,split[a][b];[a]'+bias+f'palettegen=max_colors={a.gif_colors}:reserve_transparent=0:stats_mode={a.palette_stats}[p];[b][p]paletteuse=dither={a.dither}:diff_mode=rectangle'
def record(scene,output,seconds,fps=30,crf=16):
    try:source_commit=subprocess.check_output(['git','-C',str(ROOT),'rev-parse','HEAD'],stderr=subprocess.DEVNULL,text=True).strip()
    except subprocess.CalledProcessError:source_commit='uncommitted'
    capture_tool_sha256=sha(Path(__file__))
    PRIVATE.mkdir(parents=True,mode=0o700,exist_ok=True)
    lock=(PRIVATE/'.capture.lock').open('a+')
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close();raise SystemExit('Another owned capture is active; recording refused')
    monitors=json.loads(subprocess.check_output(['hyprctl','-j','monitors']))
    monitor=next((m for m in monitors if m['name']==output),None)
    if not monitor:raise SystemExit('Output is not currently connected')
    directory=PRIVATE/scene;directory.mkdir(parents=True,mode=0o700,exist_ok=True)
    dest=directory/'source.mp4'
    if dest.exists():raise SystemExit('Scene already exists. Choose a new scene ID; sources are never overwritten.')
    args=['wf-recorder','--no-dmabuf','--no-damage','-o',output,'-c','libx264','-p','preset=ultrafast','-p','crf='+str(crf),'-x','yuv420p','-r',str(fps),'-f',str(dest)]
    interrupted=False;started=time.monotonic()
    with (directory/'recorder.log').open('w') as log:
        proc=subprocess.Popen(args,stdout=log,stderr=subprocess.STDOUT)
        save(directory/'owned-pid.json',{'pid':proc.pid,'scene':scene})
        old_term=signal.signal(signal.SIGTERM,lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
        try:
            proc.wait(timeout=seconds)
            if proc.returncode:raise SystemExit('Recorder failed; inspect private recorder.log')
        except subprocess.TimeoutExpired:
            proc.send_signal(signal.SIGINT)
        except KeyboardInterrupt:
            interrupted=True;proc.send_signal(signal.SIGINT)
        finally:
            if proc.poll() is None:
                proc.send_signal(signal.SIGINT)
            try:proc.wait(timeout=12)
            except subprocess.TimeoutExpired:proc.kill();proc.wait()
            (directory/'owned-pid.json').unlink(missing_ok=True)
            signal.signal(signal.SIGTERM,old_term)
    info=probe(dest)
    save(directory/'source.json',{'scene':scene,'sha256':sha(dest),'configuration_commit':source_commit,'capture_tool_sha256':capture_tool_sha256,'output_geometry':{k:monitor[k] for k in ['width','height','scale','name','model','refreshRate']},'recorder':f'wf-recorder CPU libx264, no-dmabuf, requested {fps} fps, no audio','arguments':args[:-1]+['<private-source>'],'probe':info,'requested_fps':fps,'wall_seconds':round(time.monotonic()-started,3),'interrupted':interrupted,'captured_utc':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime())})
    print('Captured',scene,info['format']['duration'],'seconds')
    lock.close()
    if interrupted:raise SystemExit(130)
def encode(a):
