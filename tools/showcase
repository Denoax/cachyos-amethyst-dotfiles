#!/usr/bin/env python3
"""Bounded real Wayland capture, encoding and stream verification. No generated media."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import time
import tempfile

ROOT=Path(__file__).resolve().parents[1]
PRIVATE=Path.home()/'.local/state/cachyos-amethyst-build/captures'
PUBLIC=ROOT/'showcase/assets'
def run(args,**kw):return subprocess.run(list(map(str,args)),check=True,**kw)
def probe(p):
    info=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_streams','-show_format','-of','json',str(p)]))
    if 'filename' in info.get('format',{}):info['format']['filename']=p.name
    return info
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def save(p,data):p.write_text(json.dumps(data,indent=2)+'\n')
def record(scene,output,seconds,fps=30,crf=16):
    PRIVATE.mkdir(parents=True,mode=0o700,exist_ok=True)
    lock=(PRIVATE/'.capture.lock').open('a+')
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:raise SystemExit('Another owned capture is active; recording refused')
    monitors=json.loads(subprocess.check_output(['hyprctl','-j','monitors']))
    monitor=next((m for m in monitors if m['name']==output),None)
    if not monitor:raise SystemExit('Output is not currently connected')
    directory=PRIVATE/scene;directory.mkdir(parents=True,mode=0o700,exist_ok=True)
    dest=directory/'source.mp4'
    if dest.exists():raise SystemExit('Scene already exists. Choose a new scene ID; sources are never overwritten.')
    args=['wf-recorder','--no-dmabuf','--no-damage','-o',output,'-c','libx264','-p','preset=ultrafast','-p','crf='+str(crf),'-x','yuv420p','-r',str(fps),'-f',str(dest)]
    interrupted=False;started=time.monotonic()
    with (directory/'recorder.log').open('w') as log:
        proc=subprocess.Popen(args,stdout=log,stderr=subprocess.STDOUT)
        save(directory/'owned-pid.json',{'pid':proc.pid,'scene':scene})
        old_term=signal.signal(signal.SIGTERM,lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
        try:
            proc.wait(timeout=seconds)
            if proc.returncode:raise SystemExit('Recorder failed; inspect private recorder.log')
        except subprocess.TimeoutExpired:
            proc.send_signal(signal.SIGINT)
        except KeyboardInterrupt:
            interrupted=True;proc.send_signal(signal.SIGINT)
        finally:
            if proc.poll() is None:
                proc.send_signal(signal.SIGINT)
            try:proc.wait(timeout=12)
            except subprocess.TimeoutExpired:proc.kill();proc.wait()
            (directory/'owned-pid.json').unlink(missing_ok=True)
            signal.signal(signal.SIGTERM,old_term)
    info=probe(dest)
    try:commit=subprocess.check_output(['git','-C',str(ROOT),'rev-parse','HEAD'],stderr=subprocess.DEVNULL,text=True).strip()
    except subprocess.CalledProcessError:commit='uncommitted'
    save(directory/'source.json',{'scene':scene,'sha256':sha(dest),'configuration_commit':commit,'output_geometry':{k:monitor[k] for k in ['width','height','scale','name','model','refreshRate']},'recorder':f'wf-recorder CPU libx264, no-dmabuf, requested {fps} fps, no audio','arguments':args[:-1]+['<private-source>'],'probe':info,'requested_fps':fps,'wall_seconds':round(time.monotonic()-started,3),'interrupted':interrupted,'captured_utc':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime())})
    print('Captured',scene,info['format']['duration'],'seconds')
    lock.close()
    if interrupted:raise SystemExit(130)
def encode(a):
    if not a.privacy_reviewed:raise SystemExit('Inspect the entire source for private content before --privacy-reviewed')
    source=PRIVATE/a.scene/'source.mp4';meta=json.loads((source.parent/'source.json').read_text())
    PUBLIC.mkdir(parents=True,exist_ok=True)
    duration=float(meta['probe']['format']['duration']);end=a.out if a.out is not None else duration
    if not 0<=a.start<end<=duration:raise SystemExit('Source in/out must lie inside the immutable take')
    if not a.start<=a.poster_at<end:raise SystemExit('Poster must be inside the selected source segment')
    args=['ffmpeg','-v','error','-y','-ss',str(a.start),'-i',str(source),'-t',str(end-a.start)]
    asset_id=a.asset_id or a.scene
    mp4=PUBLIC/(asset_id+'.mp4');poster=PUBLIC/(asset_id+'.png');thumb=PUBLIC/(asset_id+'.jpg');gif=PUBLIC/(asset_id+'.gif')
    commands=[]
    full=args+['-an','-c:v','libx264','-preset','medium','-crf','20','-pix_fmt','yuv420p','-movflags','+faststart',str(mp4)]
    run(full);commands.append(full)
    still=args+['-ss',str(a.poster_at),'-frames:v','1',str(poster)]
    still=['ffmpeg','-v','error','-y','-ss',str(a.poster_at),'-i',str(source),'-frames:v','1',str(poster)]
    run(still);commands.append(still)
    thumbnail=['ffmpeg','-v','error','-y','-i',str(poster),'-vf','scale=960:-1:flags=lanczos','-q:v','2',str(thumb)]
    run(thumbnail);commands.append(thumbnail)
    if a.gif:
        if not 0<=a.gif_start<a.gif_start+a.gif_seconds<=duration:raise SystemExit('GIF excerpt exceeds source')
        filt=f'fps={a.gif_fps},scale={a.gif_width}:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors={a.gif_colors}:reserve_transparent=0:stats_mode={a.palette_stats}[p];[b][p]paletteuse=dither={a.dither}:diff_mode=rectangle'
        animation=['ffmpeg','-v','error','-y','-ss',str(a.gif_start),'-t',str(a.gif_seconds),'-i',str(source),'-filter_complex',filt,'-loop','0',str(gif)]
        run(animation);commands.append(animation)
    assets=[mp4,poster,thumb]+([gif] if a.gif else [])
    meta.pop('probe',None)
    meta['edits']={'classification':a.classification,'video_source_seconds':[a.start,end],'timing':'normal speed; no interpolation, masks, replaced or reversed frames','gif_excerpt_seconds':[a.gif_start,a.gif_start+a.gif_seconds] if a.gif else None,'poster_seconds':a.poster_at,'background':'Actual local animated DesktopHut wallpaper requested by user. Raw source excluded; code license grants no wallpaper rights. https://www.desktophut.com/black-and-white-look-live-wallpaper'}
    meta['review']={'privacy':'source and derivative frame inspection; see scene evidence','continuous_motion':'MOTION_REVIEW_PENDING: human end-to-end playback and three loop wraps required','smoothness_claim':False}
    meta['encoding_commands']=[['<private-source>' if str(x)==str(source) else str(x).replace(str(ROOT)+'/','') for x in cmd] for cmd in commands]
    meta['published']=[{'path':str(p.relative_to(ROOT)),'bytes':p.stat().st_size,'sha256':sha(p),'probe':probe(p) if p.suffix in ['.mp4','.gif'] else None} for p in assets]
    save(PUBLIC/(asset_id+'.json'),meta)
    print('Encoded',a.scene)
def verify(decode=False):
    entries=[]
    for p in sorted(PUBLIC.glob('*.json')):
        meta=json.loads(p.read_text())
        for asset in meta['published']:
            file=ROOT/asset['path']
            assert file.exists() and sha(file)==asset['sha256'],file
            if file.suffix in ['.mp4','.gif']:
                info=probe(file);assert float(info['format']['duration'])>0
                stamps=json.loads(subprocess.check_output(['ffprobe','-v','error','-select_streams','v:0','-show_entries','frame=best_effort_timestamp_time','-of','json',str(file)]))['frames']
                times=[float(f['best_effort_timestamp_time']) for f in stamps];assert all(b>a for a,b in zip(times,times[1:])),file
                if decode:run(['ffmpeg','-v','error','-i',file,'-f','null','-'])
            entries.append(asset['path'])
    print('PASS hashes/streams:',len(entries),'assets. Continuous motion review remains separately recorded.')
def film(a):
    if not a.privacy_reviewed:raise SystemExit('Review every selected take before assembling a public film')
    edl=json.loads(a.edl.read_text());cuts=edl['cuts'];length=sum(c['out']-c['in'] for c in cuts)
    if not 60<=length<=90:raise SystemExit('Presentation film must be between 60 and 90 seconds')
    PUBLIC.mkdir(parents=True,exist_ok=True);lineage=[]
    with tempfile.TemporaryDirectory(prefix='amethyst-film-') as tmp:
        tmp=Path(tmp);parts=[]
        for i,cut in enumerate(cuts):
            if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,60}',cut['scene']):raise SystemExit('Unsafe source scene')
            source=PRIVATE/cut['scene']/'source.mp4';meta=json.loads((source.parent/'source.json').read_text());duration=float(meta['probe']['format']['duration'])
            if sha(source)!=meta['sha256'] or not 0<=cut['in']<cut['out']<=duration:raise SystemExit('Invalid or changed source take')
            dest=tmp/f'{i:02}.mp4';filters='fps=30,format=yuv420p'
            if cut.get('caption'):
                label=tmp/f'{i:02}.txt';label.write_text(cut['caption'])
                filters+=f',drawtext=textfile={label}:expansion=none:fontcolor=white:fontsize=26:box=1:boxcolor=black@0.65:boxborderw=10:x=80:y=h-65:enable=lt(t\\,1.8)'
            run(['ffmpeg','-v','error','-y','-ss',str(cut['in']),'-i',source,'-t',str(cut['out']-cut['in']),'-vf',filters,'-an','-c:v','libx264','-preset','medium','-crf','20','-threads','4',dest])
            parts.append(dest);lineage.append({**cut,'source_sha256':meta['sha256'],'configuration_commit':meta['configuration_commit']})
        listing=tmp/'concat.txt';listing.write_text(''.join("file '"+str(p)+"'\n" for p in parts));dest=PUBLIC/'amethyst-tour.mp4'
        run(['ffmpeg','-v','error','-y','-f','concat','-safe','0','-i',listing,'-c','copy','-movflags','+faststart',dest])
    save(PUBLIC/'amethyst-tour.json',{'scene':'amethyst-tour','classification':'edited presentation; hard cuts, no accelerated interaction','edit_decision':lineage,'review':{'continuous_motion':'MOTION_REVIEW_PENDING','smoothness_claim':False},'published':[{'path':str(dest.relative_to(ROOT)),'bytes':dest.stat().st_size,'sha256':sha(dest),'probe':probe(dest)}]})
    print('Assembled normal-speed film:',probe(dest)['format']['duration'],'seconds')
def main():
    global PRIVATE,PUBLIC
    p=argparse.ArgumentParser(description=__doc__);p.add_argument('command',choices=['doctor','record','encode','verify','film','site'])
    p.add_argument('--scene',default='probe');p.add_argument('--output');p.add_argument('--seconds',type=float,default=12)
    p.add_argument('--probe',action='store_true',help='doctor also records a two-second private compatibility probe')
    p.add_argument('--privacy-reviewed',action='store_true');p.add_argument('--gif',action='store_true')
    p.add_argument('--gif-width',type=int,default=960);p.add_argument('--gif-fps',type=int,default=25);p.add_argument('--gif-colors',type=int,default=256)
    p.add_argument('--dither',choices=['none','bayer','sierra2_4a'],default='bayer');p.add_argument('--palette-stats',choices=['full','diff'],default='full')
    p.add_argument('--gif-start',type=float,default=0);p.add_argument('--gif-seconds',type=float,default=8);p.add_argument('--poster-at',type=float,default=1)
    p.add_argument('--capture-root',type=Path,default=PRIVATE);p.add_argument('--assets-dir',type=Path,default=PUBLIC)
    p.add_argument('--fps',type=int,choices=[30,60],default=30);p.add_argument('--crf',type=int,choices=range(0,31),default=16)
    p.add_argument('--in',dest='start',type=float,default=0);p.add_argument('--out',type=float);p.add_argument('--asset-id');p.add_argument('--classification',choices=['evidence','feature','loop'],default='feature')
    p.add_argument('--edl',type=Path);p.add_argument('--decode',action='store_true');p.add_argument('--site-output',type=Path,default=ROOT/'.build/showcase-site');p.add_argument('--fetch-media',action='store_true')
    a=p.parse_args()
    PRIVATE=a.capture_root.expanduser().resolve();PUBLIC=a.assets_dir.resolve()
    if not PUBLIC.is_relative_to(ROOT):p.error('Public derivatives must stay within this checkout')
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,60}',a.scene):p.error('scene must be a safe lowercase ID')
    if a.asset_id and not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,60}',a.asset_id):p.error('asset ID must be lowercase and safe')
    if not 0<a.seconds<=180:p.error('seconds must be between 0 and 180')
    if a.command=='doctor':
        print('Wayland:',os.environ.get('XDG_SESSION_TYPE'))
        for tool in ['wf-recorder','ffmpeg','ffprobe','hyprctl']:print(tool,shutil.which(tool) or 'MISSING')
        monitors=json.loads(subprocess.check_output(['hyprctl','-j','monitors']))
        print('Outputs:',[{k:m[k] for k in ['name','width','height','scale']} for m in monitors])
        if a.probe:record(a.scene,a.output or next(m['name'] for m in monitors if m['focused']),2)
    elif a.command=='record':
        if not a.output:p.error('--output required')
        record(a.scene,a.output,a.seconds,a.fps,a.crf)
    elif a.command=='encode':encode(a)
    elif a.command=='film':
        if not a.edl:p.error('--edl required')
        film(a)
    elif a.command=='site':
        run([sys.executable,ROOT/'showcase/revision-2/build-site.py','--output',a.site_output]+(['--fetch-media'] if a.fetch_media else []))
    else:verify(a.decode)
if __name__=='__main__':main()
