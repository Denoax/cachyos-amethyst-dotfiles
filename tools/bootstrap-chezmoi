#!/usr/bin/env python3
"""Fetch the pinned official chezmoi binary; verify the reviewed archive SHA-256."""
import argparse
import hashlib
from pathlib import Path
import tarfile
import tempfile
import urllib.request

p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--destination',type=Path,required=True)
a=p.parse_args()
url='https://github.com/twpayne/chezmoi/releases/download/v2.74.1/chezmoi_2.74.1_linux_amd64.tar.gz'
expected='ae01c66b1a6dbf563667c63fbbd9986b3cfa3c98dd266ddee732f63e8af2e9d1'
with tempfile.TemporaryDirectory(prefix='amethyst-bootstrap-') as d:
    archive=Path(d)/'chezmoi.tar.gz';urllib.request.urlretrieve(url,archive)
    if hashlib.sha256(archive.read_bytes()).hexdigest()!=expected:raise SystemExit('Archive checksum mismatch')
    with tarfile.open(archive) as tf:data=tf.extractfile('chezmoi').read()
a.destination.mkdir(parents=True,exist_ok=True)
binary=a.destination/'chezmoi'
if binary.exists():raise SystemExit('Destination exists; nothing overwritten')
binary.write_bytes(data);binary.chmod(0o755)
print(binary)
