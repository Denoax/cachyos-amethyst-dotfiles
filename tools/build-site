#!/usr/bin/env python3
"""Build the site from its public media allowlist; no private/release downloads."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tempfile

ROOT=Path(__file__).resolve().parents[1]
def digest(path):return hashlib.sha256(path.read_bytes()).hexdigest()
def public_asset(relative):
    relative=Path(relative)
    if relative.is_absolute() or '..' in relative.parts or relative.parent!=Path('media'):raise SystemExit('Asset escapes the public allowlist')
    public=ROOT/'site/public';source=public/relative
    for path in [public,source,*source.parents]:
        if path==ROOT:break
        if path.is_symlink():raise SystemExit('Symlink asset or ancestor refused')
    if not source.is_file():raise SystemExit('Missing public asset: '+str(relative))
    return source

def manifest():
    public=ROOT/'site/public';media=public/'media';assets=[]
    for path in sorted(media.iterdir()):
        if path.name=='catalog.json':continue
        if path.suffix not in ['.mp4','.gif','.jpg','.png','.webp']:raise SystemExit('Unexpected public media type')
        source=public_asset('media/'+path.name)
        assets.append({'path':'media/'+path.name,'bytes':source.stat().st_size,'sha256':digest(source)})
    metadata={'schema_version':3,'policy':'Selected actual desktop derivatives. Normal application/compositor opacity. No raw wallpaper, raw captures, reference clips or private process records.','review':'Owner visual approval pending. No production release/deployment.','privacy_edits':{'dolphin':'Address bar and tooltip blurred throughout; autocomplete blurred from0.65 to2.20seconds. Original timing and normal opacity retained.'},'assets':assets}
    (media/'catalog.json').write_text(json.dumps(metadata,indent=2)+'\n')
    print('Cataloged',len(assets),'public derivatives')

def build(output,fetch=False):
    output=output.resolve()
    if not output.is_relative_to(ROOT/'.build'):raise SystemExit('Site output must remain under the checkout .build directory')
    for directory in [ROOT/'site/public',ROOT/'site/public/media']:
        if directory.is_symlink():raise SystemExit('Symlink asset or ancestor refused')
    metadata=json.loads((ROOT/'site/public/media/catalog.json').read_text())
    for asset in metadata['assets']:
        source=public_asset(asset['path'])
        if source.stat().st_size!=asset['bytes'] or digest(source)!=asset['sha256']:raise SystemExit('Asset integrity failure: '+asset['path'])
    for path in (ROOT/'site/public').rglob('*'):
        if path.is_symlink():raise SystemExit('Symlink asset or ancestor refused')
    subprocess.run(['npm','run','build'],cwd=ROOT/'site',check=True)
    dist=ROOT/'site/dist'
    if any(p.is_symlink() for p in dist.rglob('*')):raise SystemExit('Symlink build output refused')
    payload=sum(p.stat().st_size for p in dist.rglob('*') if p.is_file())
    if payload>200*1024*1024:raise SystemExit('Site exceeds the 200 MiB public payload budget')
    output.parent.mkdir(parents=True,exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='site-',dir=output.parent) as tmp:
        staged=Path(tmp)/'public';shutil.copytree(dist,staged);(staged/'.nojekyll').touch()
        if output.exists():shutil.rmtree(output)
        shutil.copytree(staged,output)
    print('Built public site:',payload,'bytes')

if __name__=='__main__':
    parser=argparse.ArgumentParser();parser.add_argument('--output',type=Path);parser.add_argument('--manifest-only',action='store_true');parser.add_argument('--fetch-media',action='store_true',help=argparse.SUPPRESS);args=parser.parse_args()
    if args.manifest_only:manifest()
    elif args.output:build(args.output,args.fetch_media)
    else:parser.error('--output or --manifest-only is required')
